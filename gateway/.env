LLM_API_KEY=sk-hp3uSiaWUqTf00aUJVREZ8PNz9cC8Ql2HGSoF7k3c817sZVd
LLM_BASE_URL=https://api.4022543.xyz/v1

# 文案档位（对应官方 flash / pro，模型见 https://api.4022543.xyz/pricing）
LLM_MODEL_FLASH=gpt-4.1-mini
LLM_MODEL_PRO=gpt-4.1

# TTS — flash 用 mini-tts，pro 用 HD（更接近官方 MiniMax 听感）
TTS_MODEL=gpt-4o-mini-tts
TTS_MODEL_FLASH=gpt-4o-mini-tts
TTS_MODEL_PRO=tts-1-hd
TTS_PROVIDER=openai
TTS_FALLBACK_EDGE=true

# 音画对齐（官方风格：跟 TTS 时长，轻微加速）
MAX_AUDIO_SPEED=1.12
NARRATION_PAD_SECONDS=0.35
MAX_NARRATION_CLIP_SECONDS=24

# 成片烧录字幕（解说词 + 原声段台词）
BURN_SUBTITLES=true
SUBTITLE_FONT=Microsoft YaHei
SUBTITLE_FONT_SIZE=24

PUBLIC_URL=http://127.0.0.1:8080
HOST=127.0.0.1
PORT=8080

# 成片时长 ≈ 原片 × TARGET_DURATION_RATIO（38分钟原片 → 约8分钟成片）
TARGET_DURATION_RATIO=0.22
WRITING_CHUNK_SECONDS=240
MIN_TARGET_DURATION=180
MAX_TARGET_DURATION=900
